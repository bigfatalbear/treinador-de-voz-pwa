# Configuracao publica do Supabase (URL e chave publicavel nao sao segredos).
# Sem estas variaveis o app inicia em MODO DEMONSTRACAO local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=media

# Login com Google e opcional; exige provedor Google configurado no Supabase Auth.
VITE_SUPABASE_GOOGLE_ENABLED=false

# Nome do coral usado no Postgres/Storage (nao e segredo).
VITE_CHOIR_ID=principal
