# Configuracao publica do Firebase Web (nao sao segredos; restrinja a API key por referrer).
# Sem estas variaveis o app inicia em MODO DEMONSTRACAO local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_REGION=southamerica-east1

# App Check (reCAPTCHA Enterprise) - chave publica do site, nao e segredo.
VITE_RECAPTCHA_SITE_KEY=

# Nome do coral usado no Firestore/Storage (nao e segredo).
VITE_CHOIR_ID=principal
